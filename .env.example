AIDLENS_ENV=development
POSTGRES_DB=aidlens
POSTGRES_USER=aidlens
AIDLENS_CORS_ORIGINS=["http://localhost:3000"]
AIDLENS_ARCHIVE_BASE_URL=https://usaid-archive.aiddata.org
AIDLENS_ARCHIVE_REQUEST_DELAY_SECONDS=0.20
AIDLENS_ARCHIVE_TIMEOUT_SECONDS=30
AIDLENS_API_EXTRAS=
AIDLENS_EMBEDDING_PROVIDER=disabled
AIDLENS_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
AIDLENS_AIDRANKER_PROVIDER=disabled
AIDLENS_AIDRANKER_MODEL=models/aidranker-v1.local
AIDLENS_AIDRANKER_CANDIDATE_K=40
AIDLENS_AIDRANKER_BATCH_SIZE=8
AIDLENS_AIDRANKER_DEVICE=auto
AIDLENS_AIDRANKER_WARMUP=true
AIDLENS_AIDRANKER_FAIL_OPEN=true
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
